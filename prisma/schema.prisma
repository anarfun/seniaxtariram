// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  displayName  String?
  passwordHash String
  role         String   @default("EDITOR") // "ADMIN", "EDITOR"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  records      ArchiveRecord[]
}

model ArchiveRecord {
  id              String   @id @default(uuid())
  firstName       String?
  lastName        String?
  fatherName      String?
  birthDate       String?
  birthPlace      String?
  missingDate     String?
  currentCity     String?
  missingLocation String?
  phoneNumbers    String?
  idCardDetails   String?
  relatives       String?
  notes           String?
  createdById     String?
  createdBy       User?    @relation(fields: [createdById], references: [id])
  status          String   @default("SEARCHING") // "SEARCHING", "FOUND", "DECEASED", "OTHER"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  media           Media[]
}

model Media {
  id              String        @id @default(uuid())
  archiveRecordId String
  archiveRecord   ArchiveRecord @relation(fields: [archiveRecordId], references: [id], onDelete: Cascade)
  type            String        // "IMAGE", "DOCUMENT"
  fileUrl         String
  note            String?
  uploadedAt      DateTime      @default(now())
}
